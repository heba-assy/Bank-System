{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Bank System",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}\\bank-system",
                "-std=c++17",
                "${workspaceFolder}\\bank-system\\main.cpp",
                "${workspaceFolder}\\bank-system\\FilesHelper.cpp",
                "${workspaceFolder}\\bank-system\\Client.cpp",
                "${workspaceFolder}\\bank-system\\Employee.cpp",
                "${workspaceFolder}\\bank-system\\Admin.cpp",
                "${workspaceFolder}\\bank-system\\Parser.cpp",
                "${workspaceFolder}\\bank-system\\Person.cpp",
                "${workspaceFolder}\\bank-system\\ClientManager.cpp",
                "-o",
                "${workspaceFolder}\\bank-system\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/bank-system"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build all .cpp files for the Bank System"
        },
        {
            "label": "Build Bank System (MSVC)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "call \"%ProgramFiles(x86)%/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat\" -arch=x64 && cl /nologo /EHsc /Zi /std:c++17 /I\"${workspaceFolder}\\bank-system\" \"${workspaceFolder}\\bank-system\\main.cpp\" \"${workspaceFolder}\\bank-system\\FilesHelper.cpp\" \"${workspaceFolder}\\bank-system\\Client.cpp\" \"${workspaceFolder}\\bank-system\\Employee.cpp\" \"${workspaceFolder}\\bank-system\\Admin.cpp\" \"${workspaceFolder}\\bank-system\\Parser.cpp\" \"${workspaceFolder}\\bank-system\\Person.cpp\" \"${workspaceFolder}\\bank-system\\ClientManager.cpp\" /Fe:\"${workspaceFolder}\\bank-system\\main.exe\""
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Build with MSVC (optional if you prefer MS toolchain)"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}